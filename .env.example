# Application Settings
APP_NAME=OneForAll
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=super-secret-key-change-me-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
# For SQLite (local quick testing): sqlite+aiosqlite:///./oneforall.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/oneforall_db
DATABASE_URL=sqlite+aiosqlite:///./oneforall.db

# AI Model Configuration
BIREFNET_MODEL_NAME=ZhengPeng7/BiRefNet
MODEL_DEVICE=cuda
PRELOAD_MODEL=false

# Cloudflare R2 Object Storage
# 1. Cloudflare Account ID: Dashboard -> Overview -> Account ID
R2_ACCOUNT_ID=your_cloudflare_account_id
# 2. R2 API Tokens: Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# 3. Bucket Name
R2_BUCKET_NAME=oneforall
# 4. (Optional) Custom endpoint or public domain
# R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

