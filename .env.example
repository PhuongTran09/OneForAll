# Application Settings
APP_NAME=OneForAll
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Supabase Auth & PostgreSQL
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Model Configuration
BIREFNET_MODEL_NAME=ZhengPeng7/BiRefNet
# Pin to a reviewed 40-character Hugging Face commit SHA before production deployment.
BIREFNET_MODEL_REVISION=
MODEL_DEVICE=cuda
PRELOAD_MODEL=false

# CORS: comma-separated JSON/list supported by Pydantic settings, e.g. ["https://example.com"]
BACKEND_CORS_ORIGINS=[]

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=oneforall
# R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
